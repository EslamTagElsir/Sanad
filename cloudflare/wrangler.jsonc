{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sanad",
	"main": "src/index.js",
	"compatibility_date": "2026-09-26",
	// Workers AI: ترميز (embedding) الاستعلامات والقطع بنموذج Qwen3-Embedding-0.6B.
	"ai": { "binding": "AI" },
	// الصفحات الثابتة تُخدَّم من نفس مجلد النسخة الأصلية تحت المسار /app/ (راجع src/index.js).
	"assets": {
		"directory": "../stage4_production/static",
		"binding": "ASSETS",
		"run_worker_first": true,
		"html_handling": "none",
		"not_found_handling": "none"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sanad-followups",
			"database_id": "478e6f32-c73e-4d3a-9136-8eb92d0d31eb",
			"migrations_dir": "migrations"
		}
	],
	// النسخة القديمة كانت تعرّف Durable Object باسم SanadContainer؛ نحذفها هنا.
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["SanadContainer"] },
		{ "tag": "v2", "deleted_classes": ["SanadContainer"] }
	],
	"vars": {
		// عنوان رابط رد العميل في الإيميل. اتركه كما هو ليؤخذ تلقائيًا من عنوان الطلب،
		// أو ضع عنوانك الفعلي/الدومين الخاص.
		"SANAD_PUBLIC_URL": "",
		"OPENROUTER_MODELS": "inclusionai/ling-3.0-flash-fin:free"
	}
	// Secrets (من لوحة التحكم أو wrangler secret put، لا تكتبها هنا أبدًا):
	// OPENROUTER_API_KEY, SANAD_JWT_SECRET, SANAD_USERS_JSON, واختياريًا
	// SENDGRID_API_KEY / SENDGRID_FROM_EMAIL.
}
