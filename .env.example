# انسخ هذا الملف إلى .env واملأ القيم محليًا فقط — هذا الملف مُستبعد من git عبر .gitignore
# ولا يُرفع أبدًا. اترك أي متغير فارغًا أو احذف سطره لتعطيل الميزة المرتبطة به.

# --- توليد المسودات: مقسّمة بين مزوّدين (بلا Anthropic — لم تُضَف) ---
# التوزيع (راجع common.py لتفاصيل كل دالة):
#   Hugging Face  = المهام الخفيفة/القصيرة: ترجمة السؤال، ترتيب المصادر (rerank)،
#                   تحقق الحالات الحدّية (كلها ردود قصيرة جدًا).
#   OpenRouter    = المهام الأثقل: توليد المسودة نفسها، وتقييم Faithfulness.
# كل مهمة لها مزوّد أساسي، وتحوّل تلقائيًا (يسلّم) للمزوّد التاني لو الأساسي فشل.
#
# ملحوظة صادقة: حصة HF المجانية اتخلصت تمامًا هذا الشهر (402 Payment Required
# على كل الموديلات، حتى الصغيرة منها بسبب استدعاءات Qwen2.5-72B الغالية
# سابقًا) — فعليًا كل شيء هيشتغل عبر OpenRouter لحد ما تتجدد حصة HF الشهرية،
# بفضل آلية التسليم التلقائي بين المزوّدين.

# من https://openrouter.ai/keys — تم اختباره فعليًا وشغال (موديل مجاني حقيقي).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nex-agi/nex-n2.5-pro:free

HF_API_TOKEN=
# Qwen2.5-72B-Instruct هو آخر موديل اشتغل قبل نفاد الحصة. جرّبنا بدائل أرخص
# (Llama-3.1-8B, Qwen2.5-14B/32B, Phi-3.5-mini, Mistral-7B) ومفيش واحد فيهم
# شغال حاليًا — إما 402 (حصة خالصة) أو الموديل مش مفعّل على providers حسابك.
HF_MODEL_ID=Qwen/Qwen2.5-72B-Instruct

# --- stage2_hybrid: تفعيل مجموعة البيانات الصناعية الكبيرة لاختبار الحجم ---
# AGENT_ASSIST_LARGE_DATA=1

# --- stage4_production: صلاحيات موظف/عميل (X-API-Key، توافقية/اختبارات) ---
# فاضيين = النظام مفتوح افتراضيًا (وضع تطوير). لتفعيل الصلاحيات بدون تسجيل
# دخول تفاعلي (أتمتة/اختبارات)، عبّي مفاتيح مفصولة بفواصل:
# AGENT_ASSIST_EMPLOYEE_KEYS=emp-key-1,emp-key-2
# AGENT_ASSIST_CUSTOMER_KEYS=cust-key-1
AGENT_ASSIST_EMPLOYEE_KEYS=
AGENT_ASSIST_CUSTOMER_KEYS=

# --- تسجيل الدخول الحقيقي (stage4_production/auth.py) ---
# سرّ توقيع الـ JWT. لازم يفضل ثابت (لو فاضي، يتولّد سر عشوائي مختلف كل مرة
# تشغّل السيرفر، وده هيلغي كل الجلسات المسجّلة كل إعادة تشغيل). اتولّد لك واحد
# جاهز — تقدر تغيّره وقتما تحب، بس متسيبوش فاضي في الإنتاج.
AGENT_ASSIST_JWT_SECRET=

# --- إرسال الرد فعليًا بالإيميل (stage4_production/email_service.py) ---
# من https://app.sendgrid.com/settings/api_keys — بدونه، زرار "إرسال للعميل"
# هيفشل برسالة واضحة والموظف يقدر ينسخ المسودة ويبعتها يدويًا بدل ما يقفل.
SENDGRID_API_KEY=
# لازم يكون إيميل فعلي "Verified Sender" متأكد منه في حساب SendGrid (Settings
# > Sender Authentication) — مثال: support@yourdomain.com.
SENDGRID_FROM_EMAIL=

# --- الاسترجاع الدلالي (stage2_hybrid/rag.py) ---
# نموذج embedding متعدد اللغات (Qwen3-Embedding-0.6B، ~1.2GB في كاش WSL)، الأفضل على المجموعة
# الذهبية (python -m evaluation.compare_embedders). يعمل بدون إنترنت؛ اتركه فاضي لتعطيله.
AGENT_ASSIST_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B

# --- وضع التطوير المفتوح (بدون تسجيل دخول) — لا تفعّله إلا محليًا ---
# AGENT_ASSIST_DEV_OPEN=1
